# ==============================================================================
# LINKEDIN JOB AGENT - ORTAM DEĞİŞKENLERİ (.env.example)
# ==============================================================================
# Bu dosyayı '.env' olarak kopyalayın ve kendi API anahtarlarınızı girin.
# .env dosyası .gitignore içindedir ve asla git deposuna yüklenmez.
# ==============================================================================

# 1. Google Gemini API Ayarları
# https://aistudio.google.com/ adresinden ücretsiz API anahtarı edinebilirsiniz.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Telegram Bot Bildirim Ayarları
# @BotFather üzerinden oluşturduğunuz bot token ve @userinfobot üzerinden chat_id'niz
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ENABLED=true
